{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "0.0.1",
  "identifier": "dev.folio.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist",
    "beforeDevCommand": "npm --prefix web run dev",
    "beforeBuildCommand": "npm --prefix web run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Folio", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 480, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"] }
}
